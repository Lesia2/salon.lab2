# Скопіюй цей файл як .env і впиши свої значення.
# Файл .env НЕ потрапляє в Git (див. .gitignore).

# Підключення до MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=впиши_свій_пароль
DB_NAME=salon
TEST_DB_NAME=salon_test

# JWT
JWT_SECRET=заміни_на_довгий_випадковий_рядок
JWT_EXPIRE_MINUTES=60

# Адміністратор (створюється автоматично під час першого запуску)
ADMIN_EMAIL=admin@salon.com
ADMIN_PASSWORD=admin12345
